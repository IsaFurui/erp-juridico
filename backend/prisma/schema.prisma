// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  FINANCEIRO
  OPERACIONAL
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  cnpj      String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  users     User[]
  expenses  Expense[]
  clients   Client[]
  processes Process[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  login        String
  passwordHash String
  role         UserRole @default(OPERACIONAL)
  companyId    Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, login])
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  cpfCnpj   String
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
  companyId Int

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  processes Process[]

  @@unique([companyId, cpfCnpj])
}

model Expense {
  id        Int      @id @default(autoincrement())
  name      String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  companyId Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

model ProcessStatus {
  id          Int    @id @default(autoincrement())
  description String @unique

  processes Process[]
}

model ProcessType {
  id   Int    @id @default(autoincrement())
  name String @unique

  processes Process[]
  subtypes  ProcessSubtype[]
}

model ProcessSubtype {
  id            Int    @id @default(autoincrement())
  name          String
  processTypeId Int

  type ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Restrict)

  @@unique([processTypeId, name])
}

model Process {
  id             Int      @id @default(autoincrement())
  name           String
  code           String   @unique
  clientId       Int
  companyId      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  statusId       Int
  fixedAmount    Decimal? @db.Decimal(12, 2)
  expectedAmount Decimal? @db.Decimal(12, 2)
  totalAmount    Decimal  @default(0) @db.Decimal(12, 2)
  typeId         Int

  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status  ProcessStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  type    ProcessType   @relation(fields: [typeId], references: [id], onDelete: Restrict)
}
