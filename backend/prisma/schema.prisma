// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  FINANCEIRO
  OPERACIONAL
}

/// Categoria de uma despesa do escritório. Valores em código (sem acento/espaço);
/// o rótulo legível vive no frontend (expense-category.ts).
enum ExpenseCategory {
  ALUGUEL
  CONTAS
  PESSOAL
  SOFTWARE
  IMPOSTOS
  MARKETING
  MATERIAL
  CUSTAS
  OUTROS
}

/// Dono da plataforma. Fica fora da árvore de Company de propósito: não é um
/// escritório, administra todos. Nasce pelo seed, nunca pela API.
model PlatformAdmin {
  id           Int      @id @default(autoincrement())
  name         String
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  active       Boolean  @default(true)
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  cnpj      String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  users     User[]
  expenses  Expense[]
  clients   Client[]
  processes Process[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  login        String
  passwordHash String
  role         UserRole @default(OPERACIONAL)
  companyId    Int

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  statusChanges ProcessStatusHistory[]

  @@unique([companyId, login])
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  cpfCnpj   String
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
  companyId Int

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  processes Process[]

  @@unique([companyId, cpfCnpj])
}

model Expense {
  id        Int             @id @default(autoincrement())
  name      String
  amount    Decimal         @db.Decimal(12, 2)
  category  ExpenseCategory @default(OUTROS)
  date      DateTime        @default(now()) @db.Date
  createdAt DateTime        @default(now())
  companyId Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, date])
}

model ProcessStatus {
  id          Int     @id @default(autoincrement())
  description String  @unique
  isFinal     Boolean @default(false)

  processes Process[]
  history   ProcessStatusHistory[]
}

model ProcessType {
  id   Int    @id @default(autoincrement())
  name String @unique

  processes Process[]
  subtypes  ProcessSubtype[]
}

model ProcessSubtype {
  id            Int    @id @default(autoincrement())
  name          String
  processTypeId Int

  type      ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Restrict)
  processes Process[]

  @@unique([processTypeId, name])
}

model Process {
  id             Int      @id @default(autoincrement())
  name           String
  code           String   @unique
  clientId       Int
  companyId      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  statusId       Int
  fixedAmount    Decimal? @db.Decimal(12, 2)
  expectedAmount Decimal? @db.Decimal(12, 2)
  totalAmount    Decimal  @default(0) @db.Decimal(12, 2)
  typeId         Int
  subtypeId      Int?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client  Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status  ProcessStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  type    ProcessType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  subtype ProcessSubtype? @relation(fields: [subtypeId], references: [id], onDelete: Restrict)

  statusHistory ProcessStatusHistory[]
}

/// Livro de registro do status do processo: ganha uma linha a cada mudança,
/// nunca sobrescreve. É o que transforma a listagem num acompanhamento.
model ProcessStatusHistory {
  id        Int      @id @default(autoincrement())
  processId Int
  statusId  Int
  userId    Int
  changedAt DateTime @default(now())
  note      String?

  process Process       @relation(fields: [processId], references: [id], onDelete: Restrict)
  status  ProcessStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict)
}
