// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  FINANCEIRO
  OPERACIONAL
}

/// Categoria de uma despesa do escritório. Valores em código (sem acento/espaço);
/// o rótulo legível vive no frontend (expense-category.ts).
enum ExpenseCategory {
  ALUGUEL
  CONTAS
  PESSOAL
  SOFTWARE
  IMPOSTOS
  MARKETING
  MATERIAL
  CUSTAS
  OUTROS
}

/// Sigilo do processo. É estado do próprio processo: o tipo só dá o valor
/// inicial (ProcessType.defaultConfidential), o advogado corrige na mão.
/// Processo CONFIDENTIAL fica fora do monitoramento automático do DataJud
/// (a API pública não retorna processo em segredo de justiça).
enum Confidentiality {
  PUBLIC
  CONFIDENTIAL
}

/// Estado da última consulta ao DataJud para um processo.
/// NEVER_SYNCED: nunca consultado (inclui processo sem alias de tribunal).
/// SYNCED: encontrado e movimentos importados. NOT_FOUND: consulta vazia
/// (recente ou em sigilo não marcado — não é erro). ERROR: falha de rede/HTTP.
enum DatajudSyncStatus {
  NEVER_SYNCED
  SYNCED
  NOT_FOUND
  ERROR
}

/// Dono da plataforma. Fica fora da árvore de Company de propósito: não é um
/// escritório, administra todos. Nasce pelo seed, nunca pela API.
model PlatformAdmin {
  id           Int      @id @default(autoincrement())
  name         String
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  active       Boolean  @default(true)
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  cnpj      String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  users     User[]
  expenses  Expense[]
  clients   Client[]
  processes Process[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  login        String
  passwordHash String
  role         UserRole @default(OPERACIONAL)
  avatarUrl    String?
  companyId    Int

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  statusChanges ProcessStatusHistory[]
  notifications Notification[]
  responsibleFor Process[]

  @@unique([companyId, login])
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  cpfCnpj   String
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
  companyId Int

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  processes Process[]

  @@unique([companyId, cpfCnpj])
}

model Expense {
  id        Int             @id @default(autoincrement())
  name      String
  amount    Decimal         @db.Decimal(12, 2)
  category  ExpenseCategory @default(OUTROS)
  date      DateTime        @default(now()) @db.Date
  createdAt DateTime        @default(now())
  companyId Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, date])
}

model ProcessStatus {
  id          Int     @id @default(autoincrement())
  description String  @unique
  isFinal     Boolean @default(false)

  processes Process[]
  history   ProcessStatusHistory[]
}

model ProcessType {
  id                 Int     @id @default(autoincrement())
  name               String  @unique
  /// Valor inicial de sigilo sugerido ao criar um processo deste tipo. Só o
  /// root edita (rota de escrita de catálogo). Não altera processos já criados.
  defaultConfidential Boolean @default(false)

  processes Process[]
  subtypes  ProcessSubtype[]
}

model ProcessSubtype {
  id            Int    @id @default(autoincrement())
  name          String
  processTypeId Int

  type      ProcessType @relation(fields: [processTypeId], references: [id], onDelete: Restrict)
  processes Process[]

  @@unique([processTypeId, name])
}

model Process {
  id             Int      @id @default(autoincrement())
  name           String
  code           String   @unique
  clientId       Int
  companyId      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  statusId       Int
  fixedAmount    Decimal? @db.Decimal(12, 2)
  expectedAmount Decimal? @db.Decimal(12, 2)
  totalAmount    Decimal  @default(0) @db.Decimal(12, 2)
  typeId         Int
  subtypeId      Int?
  responsibleId  Int?

  confidentiality   Confidentiality   @default(PUBLIC)
  /// Monitoramento DataJud. O job só pega PUBLIC com datajudNextSyncAt vencido
  /// ou nulo e datajudAlias não nulo. datajudAlias é derivado do code (número
  /// CNJ) e gravado na criação/edição — número sem tribunal reconhecível fica
  /// com alias nulo e, portanto, fora do job. datajudNextSyncAt cresce no
  /// backoff de NOT_FOUND (datajudNotFoundStreak conta as tentativas vazias
  /// seguidas); datajudSyncedAt marca a última consulta bem-sucedida.
  datajudSyncStatus     DatajudSyncStatus @default(NEVER_SYNCED)
  datajudAlias          String?
  datajudSyncedAt       DateTime?
  datajudNextSyncAt     DateTime?
  datajudNotFoundStreak Int               @default(0)

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status      ProcessStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  type        ProcessType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  subtype     ProcessSubtype? @relation(fields: [subtypeId], references: [id], onDelete: Restrict)
  responsible User?           @relation(fields: [responsibleId], references: [id], onDelete: SetNull)

  statusHistory ProcessStatusHistory[]
  movements     ProcessMovement[]
}

/// Notificação de um usuário (destinatário). Uma linha por pessoa, com estado
/// de lido próprio. `processId` é um ponteiro solto (sem FK) para o delete
/// físico de processo não esbarrar em Restrict.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  companyId Int
  type      String
  message   String
  processId Int?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

/// Livro de registro do status do processo: ganha uma linha a cada mudança,
/// nunca sobrescreve. É o que transforma a listagem num acompanhamento.
model ProcessStatusHistory {
  id        Int      @id @default(autoincrement())
  processId Int
  statusId  Int
  userId    Int
  changedAt DateTime @default(now())
  note      String?

  process Process       @relation(fields: [processId], references: [id], onDelete: Restrict)
  status  ProcessStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict)
}

/// Movimento processual importado do DataJud (andamento no tribunal). É coisa
/// distinta de ProcessStatusHistory (essa é a troca de status DENTRO do
/// sistema). `code`/`name` vêm da tabela de movimentos do CNJ; `occurredAt` é
/// o `dataHora` do movimento. A unique (processId, code, occurredAt) deduplica
/// entre sincronizações. `complements` guarda os complementosTabelados crus.
model ProcessMovement {
  id          Int      @id @default(autoincrement())
  processId   Int
  code        Int
  name        String
  occurredAt  DateTime
  complements Json?
  createdAt   DateTime @default(now())

  process Process @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@unique([processId, code, occurredAt])
}
