DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal_erp"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Origem(ns) do frontend liberada(s) no CORS, separadas por vírgula.
# Em dev pode deixar vazio (tudo passa pelo proxy do Vite, mesma origem).
CORS_ORIGIN=""

# Administrador da plataforma (root). Criado pelo seed — a API não cria nem
# promove ninguém a esse papel, e ele não pertence a empresa nenhuma
# (tabela PlatformAdmin, fora da árvore de Company).
# Rodar o seed de novo com uma senha nova redefine a senha: é o caminho de
# recuperação. Para um segundo root, troque PLATFORM_ADMIN_LOGIN.
PLATFORM_ADMIN_NAME="Administrador da Plataforma"
PLATFORM_ADMIN_LOGIN="root"
PLATFORM_ADMIN_PASSWORD=""

# Chave da API pública do DataJud (CNJ), usada no monitoramento de andamentos.
# É uma chave pública publicada pelo CNJ, mas pode ser trocada por eles — por
# isso fica aqui e NUNCA no código/commit. Cabeçalho enviado:
# "Authorization: APIKey <chave>" (não é Basic Auth). Sem ela, o job de
# sincronização e o POST /processes/:id/sync falham com erro claro.
DATAJUD_API_KEY=""
